; hledger journal file - Exemplo de Finanças Pessoais
; Encoding: UTF-8

; === CONTAS PRINCIPAIS ===
; Ativo
account assets:banco:nubank          ; Conta corrente Nubank
account assets:banco:inter           ; Conta Inter
account assets:carteira              ; Dinheiro em espécie
account assets:investimentos:acoes   ; Ações
account assets:investimentos:fiis    ; Fundos Imobiliários

; Passivo
account liabilities:cartao:nubank    ; Cartão de crédito Nubank
account liabilities:cartao:inter     ; Cartão de crédito Inter

; Receitas
account income:salario               ; Salário
account income:freelance             ; Trabalho freelance
account income:investimentos         ; Dividendos e rendimentos

; Despesas
account expenses:moradia:aluguel     ; Aluguel
account expenses:moradia:condominio  ; Condomínio
account expenses:moradia:luz         ; Conta de luz
account expenses:moradia:agua        ; Conta de água
account expenses:moradia:internet    ; Internet
account expenses:alimentacao:mercado ; Supermercado
account expenses:alimentacao:restaurante ; Restaurantes
account expenses:transporte:combustivel  ; Gasolina
account expenses:transporte:uber     ; Uber/99
account expenses:saude:plano         ; Plano de saúde
account expenses:saude:farmacia      ; Farmácia
account expenses:educacao:cursos     ; Cursos online
account expenses:lazer:streaming     ; Netflix, Spotify, etc
account expenses:lazer:cinema        ; Cinema
account expenses:lazer:viagem        ; Viagens
account expenses:vestuario           ; Roupas
account expenses:outros              ; Outras despesas

